{
  "info": {
    "name": "Fila virtual de turnos",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "idTurno12",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "P01 Fila inicial",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/fila/espera"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const d = pm.response.json();",
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('5 personas en espera (6, 7, 8, 9, 10)', () => pm.expect(d.enEspera).to.eql(5));",
              "pm.test('Nadie ha sido llamado aun', () => pm.expect(d.turnoActual).to.be.null);"
            ]
          }
        }
      ]
    },
    {
      "name": "P02 Espera promedio (requisito)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/fila/espera"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const d = pm.response.json();",
              "pm.test('Expone la espera promedio', () => pm.expect(d).to.have.property('esperaPromedioMin'));",
              "pm.test('Espera promedio 12.2 min', () => pm.expect(d.esperaPromedioMin).to.eql(12.2));"
            ]
          }
        }
      ]
    },
    {
      "name": "P03 Turno 7 pendiente cargado del CSV",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/turnos/9"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const d = pm.response.json();",
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Es el turno 7', () => pm.expect(d.numero).to.eql(7));",
              "pm.test('Esta esperando', () => pm.expect(d.estado).to.eql('ESPERANDO'));",
              "pm.test('Tiene 1 persona delante (el 6)', () => pm.expect(d.personasDelante).to.eql(1));"
            ]
          }
        }
      ]
    },
    {
      "name": "P04 Turno 7 cancelado cargado del CSV",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/turnos/8"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const d = pm.response.json();",
              "pm.test('Es el turno 7', () => pm.expect(d.numero).to.eql(7));",
              "pm.test('Esta cancelado', () => pm.expect(d.estado).to.eql('CANCELADO'));"
            ]
          }
        }
      ]
    },
    {
      "name": "P05 Cliente pide turno",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/turnos"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const d = pm.response.json();",
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "pm.test('Recibe el numero 11 (maximo + 1)', () => pm.expect(d.numero).to.eql(11));",
              "pm.test('Queda esperando', () => pm.expect(d.estado).to.eql('ESPERANDO'));",
              "pm.test('Tiene 5 personas delante', () => pm.expect(d.personasDelante).to.eql(5));"
            ]
          }
        }
      ]
    },
    {
      "name": "P06 Numeros no se repiten",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/turnos"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const d = pm.response.json();",
              "pm.test('Recibe el numero 12', () => pm.expect(d.numero).to.eql(12));",
              "pm.collectionVariables.set('idTurno12', d.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "P07 Asesor llama al siguiente",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/turnos/siguiente"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const d = pm.response.json();",
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Llama al turno 6 (el primero en llegar)', () => pm.expect(d.numero).to.eql(6));",
              "pm.test('Quedan 6 en espera', () => pm.expect(d.enEspera).to.eql(6));"
            ]
          }
        }
      ]
    },
    {
      "name": "P08 Orden de llegada, no de archivo",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/turnos/siguiente"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const d = pm.response.json();",
              "pm.test('Llama al 7 y no al 9', () => pm.expect(d.numero).to.eql(7));"
            ]
          }
        }
      ]
    },
    {
      "name": "P09 Fila muestra el turno actual",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/fila/espera"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const d = pm.response.json();",
              "pm.test('Turno actual es el 7', () => pm.expect(d.turnoActual).to.eql(7));",
              "pm.test('Quedan 5 en espera', () => pm.expect(d.enEspera).to.eql(5));"
            ]
          }
        }
      ]
    },
    {
      "name": "P10 Marcar actual como atendido",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/turnos/actual/atendido"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const d = pm.response.json();",
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Atiende al turno 7', () => pm.expect(d.numero).to.eql(7));",
              "pm.test('Queda atendido', () => pm.expect(d.estado).to.eql('ATENDIDO'));"
            ]
          }
        }
      ]
    },
    {
      "name": "P11 Turno inexistente",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/turnos/999"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 404', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "P12 Cancelar turno en espera",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/turnos/{{idTurno12}}/cancelar"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const d = pm.response.json();",
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Queda cancelado', () => pm.expect(d.estado).to.eql('CANCELADO'));"
            ]
          }
        }
      ]
    },
    {
      "name": "P13 No cancelar dos veces",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/turnos/{{idTurno12}}/cancelar"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 409', () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "P14 No cancelar un atendido",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/turnos/1/cancelar"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 409', () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "P15 Vaciar fila y llamar con fila vacia",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/turnos/siguiente"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "  postman.setNextRequest('P15 Vaciar fila y llamar con fila vacia');",
              "} else {",
              "  pm.test('Fila vacia responde 409', () => pm.response.to.have.status(409));",
              "  pm.test('Mensaje de fila vacia', () => pm.expect(pm.response.text()).to.include('No hay personas en espera'));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "P16 Fila vacia",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/fila/espera"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('0 en espera', () => pm.expect(pm.response.json().enEspera).to.eql(0));"
            ]
          }
        }
      ]
    }
  ]
}