    {
      "name": "API-20 Rechazados no consumen numero",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/turnos",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"nombre\": \"Laura Rios\", \"servicio\": \"Pagos y consultas\"}"
        }
      },
