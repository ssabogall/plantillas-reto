    },
    {
      "name": "API-10 Vaciar fila y llamar",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/turnos/siguiente"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "  postman.setNextRequest('API-10 Vaciar fila y llamar');",
              "} else {",
              "  pm.test('Fila vacia responde 409', () => pm.response.to.have.status(409));",
              "  pm.test('Mensaje de fila vacia', () => pm.expect(pm.response.text()).to.include('vacia'));",
              "}"
            ]
          }
        }
      ]
    }
  ]
}